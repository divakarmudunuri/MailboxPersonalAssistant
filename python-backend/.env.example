# Copy this file to .env and set GMAIL_ADDRESS. Everything else is optional.
# The app keeps its files under python-backend/: .secrets/ (credentials.json, token.json),
# data/ (database, memory, ignore list, traces, briefing, mail cursor), and logs/.

# ---- Mailbox ----
# Your Gmail address (the IMAP login)
GMAIL_ADDRESS=
# On first start, also triage mail from this many days back (0 = only new mail)
MAIL_BACKFILL_DAYS=0
# Gmail labels to ignore without asking the model, comma separated (yours, or system ones such as SENT,CHAT,DRAFT)
PRE_TRIAGE_IGNORE_LABELS=
# How often to send newly stored mail to the triage agent, in seconds
TRIAGE_INTERVAL_SECONDS=30
# How often to rebuild the inbox briefing, in seconds (10800 = 3 hours)
REPORT_INTERVAL_SECONDS=10800

# ---- Models ----
# One provider (ollama, anthropic, or openai) and one model per agent.
# Local models must support tool calling. Pull them first: ollama pull qwen3:4b qwen3:8b
# For the strongest results use provider anthropic and model claude-sonnet-5 everywhere.
TRIAGE_LLM_PROVIDER=ollama
TRIAGE_MODEL=qwen3:4b
MEMORY_CHAT_LLM_PROVIDER=ollama
MEMORY_CHAT_MODEL=qwen3:4b
MANAGER_LLM_PROVIDER=ollama
MANAGER_MODEL=qwen3:8b
REPORT_LLM_PROVIDER=ollama
REPORT_MODEL=qwen3:8b

# ---- Providers ----
# Where Ollama runs, and the context window to ask it for (its default 4096 is too small)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=32768
# API keys, only needed for agents on that provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Optional ----
# LangSmith tracing of every agent run (key from https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mailbox-assistant
# INFO, or DEBUG to log full email contents
LOG_LEVEL=INFO
