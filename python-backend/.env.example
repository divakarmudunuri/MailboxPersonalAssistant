# Copy this file to .env and fill in what you need. Every setting has a default; only API keys are required
# for the cloud providers. .env is gitignored; .env.example is committed.

# --- Triage model ------------------------------------------------------------------------
# Which backend classifies mail: ollama (default, local, no key), anthropic, or openai.
LLM_PROVIDER=ollama

# Ollama (LLM_PROVIDER=ollama). Pull the model first: ollama pull gpt-oss:20b
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context window requested from Ollama. Its default of 4096 tokens is too small for the briefing agent's tool results.
OLLAMA_NUM_CTX=32768

# Anthropic (LLM_PROVIDER=anthropic). Key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI (LLM_PROVIDER=openai). Key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# The inbox briefing (Home tab) uses its own provider and model; it needs a model that supports tool calling.
REPORT_LLM_PROVIDER=ollama
REPORT_MODEL=gemma4:12b

# --- Gmail polling -----------------------------------------------------------------------
# Seconds between automatic inbox briefings (the first one is built at startup); default three hours
REPORT_INTERVAL_SECONDS=10800
# The mailbox address. Required: it is the IMAP login name. Everything reads and changes mail over IMAP with OAuth;
# new mail is detected with IDLE (push, no polling, no API quota).
GMAIL_ADDRESS=
# OAuth client secrets (Desktop app) downloaded from Google Cloud Console, and the cached user token
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# Stores the watcher's cursor (UIDVALIDITY:last UID); delete it to start over
MAIL_CHECK_STATE_FILE=.mail_check_state.json
# On a fresh start (no cursor file), triage inbox mail from this many days ago first; 0 waits for new mail only
MAIL_BACKFILL_DAYS=0
# Your own Gmail labels whose mail is ignored in pre-triage with no model call, comma separated. Gmail's Promotions,
# Social, Forums, Spam, and muted mail are always ignored there.
PRE_TRIAGE_IGNORE_LABELS=

# --- Server and storage ------------------------------------------------------------------
# Port used by `uv run mail-assistant`
API_PORT=8000
# SQLite database
MAIL_DB_FILE=mail_assistant.db
# Long-term memory: learned preferences and per-sender facts
MEMORY_FILE=long_term_memory.json
# Trace log: one JSON line per graph step per email (shown on the Traces tab)
TRACE_FILE=traces.jsonl
# Last inbox briefing written by the report agent (shown on the Home tab)
REPORT_FILE=inbox_report.json
# INFO for one-line summaries, DEBUG to also log full message contents
LOG_LEVEL=INFO
